# Copy to .env.local and fill in. .env.local is gitignored.
# See README.md "Environment Configuration" for the canonical reference.

# === Convex deployment ===
# Get these from `npx convex dev` first-run output.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# === VAPID (Web Push) ===
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Set the same values in BOTH this file AND the Convex dashboard env vars.
# The Convex runtime (convex/push_actions.ts) reads from its own env, not Next.js's.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/dimsedra/dialogue-ai/issues

# === Encryption key (Convex dashboard ONLY, never Next.js) ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every stored user API key in userProfile.preferences.customConfigs.
# ENCRYPTION_KEY=

# === Search providers (server-side fallbacks; per-user keys preferred) ===
# TAVILY_API_KEY=
# SERPER_API_KEY=

# === Local LLM (optional) ===
# NEXT_PUBLIC_LM_API_TOKEN=lm-studio
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
